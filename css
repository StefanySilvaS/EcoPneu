body {
  font-family: Arial, sans-serif;
  background: #e0f7e9;
  margin: 0;
  padding: 0;
  font-size: 16px;
}

.container {
  width: 95%;      
  max-width: 600px; 
  margin: 20px auto;
  background: white;
  padding: 25px;
  border-radius: 18px;
  box-shadow: 0 0 20px rgba(0,0,0,0.15);
  text-align: center;
}

h1 {
  color: #2ecc71;
  font-size: 28px;
}

h2 {
  margin-top: 25px;
  color: #333;
  font-size: 22px;
}

p {
  color: #444;
}

.form-card {
  width: 250px;      
  margin: 0 auto 20px auto;
  background: #f0f9f4;
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0 3px 10px rgba(0,0,0,0.15);
  text-align: left;
}

input, select, button {
  width: 100%;
  margin-top: 16px;
  padding: 16px;
  border-radius: 10px;
  border: 1px solid #ccc;
  font-size: 16px;
}

button {
  background: #2ecc71;
  color: white;
  border: none;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  transition: all 0.2s ease;
  border-radius: 12px;
}

button:hover {
  background: #27ae60;
}

button:active {
  transform: scale(0.97);
  box-shadow: 0 2px 6px rgba(0,0,0,0.2);
}

#mensagem {
  margin-top: 15px;
  font-weight: bold;
  color: #2ecc71;
  font-size: 16px;
  background: #eafaf1;
  padding: 12px;
  border-radius: 8px;
  animation: aparecer 0.5s ease;
}

.item-historico {
  background: #f0f9f4;
  padding: 12px;
  margin-top: 12px;
  border-radius: 10px;
  text-align: left;
  font-size: 14px;
  border-left: 5px solid #2ecc71;
}

.detalhe {
  display: none;
  margin-top: 10px;
  background: #f0f9f4;
  padding: 12px;
  border-radius: 10px;
  font-size: 14px;
  text-align: left;
}

.etapas-container {
  display: flex;
  gap: 15px;
  overflow-x: auto;
  padding-bottom: 15px;
  margin-top: 20px;
  -webkit-overflow-scrolling: touch;
}

.etapas-container::-webkit-scrollbar {
  display: none;
}

.etapa {
  flex: 0 0 260px;
  min-height: 180px;
  background: #eafaf1;
  padding: 20px;
  border-left: 6px solid #2ecc71;
  border-radius: 10px;
  text-align: left;
  font-size: 16px;
  box-shadow: 0 3px 8px rgba(0,0,0,0.12);
  transition: transform 0.2s;
}
.etapa {
  flex: 0 0 280px; 
}
.etapa h3 {
  font-size: 24px;
  margin-bottom: 8px;
}

.etapa p {
  margin-top: 5px;
  font-size: 15px;
  color: #444;
}

.etapa button {
  margin-top: 12px;
  padding: 14px;
  width: 100%;
  background: #27ae60;
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 3px 8px rgba(0,0,0,0.2);
  transition: all 0.2s ease;
}

.etapa button:hover {
  background: #1e8449;
  transform: translateY(-2px);
}

.etapa button:active {
  transform: scale(0.96);
  box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}

@keyframes aparecer {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

#formulario {
  animation: aparecer 0.5s ease;
}

.form-card {
  width: 100%;      
  max-width: 280px;  
  margin: 10px auto; 
  display: flex;
  flex-direction: column;
}

.form-card input,
.form-card select {
  width: 100%;
  padding: 12px;
  font-size: 16px;
  border-radius: 10px;
  border: 1px solid #ccc;
}

@media (max-width: 480px) {
  .container { padding: 25px; }
  .form-card { width: 95%; }
  .etapa { flex: 0 0 220px; min-height: 160px; }
  h1 { font-size: 24px; }
  h2 { font-size: 20px; }
  input, select, button { font-size: 15px; padding: 14px; }
}
#formulario input,
#formulario select {
  width: 100%;        
  padding: 16px;   
  border-radius: 10px;
  border: 1px solid #ccc;
  font-size: 16px;
  box-sizing: border-box; 
  margin-top: 16px;
}
#btn-apagar {
  width: 100%;
  padding: 14px;
  background: #e74c3c;
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 10px;
  box-shadow: 0 3px 8px rgba(0,0,0,0.2);
}

#btn-apagar:hover { background: #c0392b; }
#btn-apagar:active { transform: scale(0.96); }